{% comment %}
  ============================================================
  FAROUSH - Section FAQ Accordéon
  Adapté pour H3 (accordéons principaux) et H4 (sous-accordéons)
  ============================================================
{% endcomment %}

{%- liquid
  assign show_content = false
  assign content_to_display = blank
  
  if section.settings.manual_content != blank
    assign show_content = true
    assign content_to_display = section.settings.manual_content
  elsif request.page_type == 'collection' and collection != blank
    if collection.metafields.custom.faq != blank
      assign show_content = true
      assign content_to_display = collection.metafields.custom.faq
    elsif collection.metafields.custom.description != blank
      assign show_content = true
      assign content_to_display = collection.metafields.custom.description
    endif
  elsif request.page_type == 'page' and page != blank
    if page.metafields.custom.faq != blank
      assign show_content = true
      assign content_to_display = page.metafields.custom.faq
    elsif page.metafields.custom.description_longue != blank
      assign show_content = true
      assign content_to_display = page.metafields.custom.description_longue
    endif
  endif
-%}

{% if show_content %}

  <div class="fr-accordion-wrapper fr-section-wrapper">
    <div class="fr-accordion-content-raw" style="display:none;">
      {{ content_to_display }}
    </div>
    <div class="fr-accordion-rendered"></div>
  </div>

  <style>
    /* ===================================================
       FAROUSH ACCORDION — BASE
       =================================================== */

    .fr-accordion-wrapper {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .fr-section-wrapper {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      {% if section.settings.show_border_top %}
      padding-top: {{ section.settings.margin_top }}px;
      border-top: 1px solid #eee;
      {% endif %}
    }

    /* ===================================================
       SOMMAIRE (Table of Contents)
       =================================================== */

    .fr-accordion-toc {
      background: #f8f8f6;
      padding: 24px 28px;
      margin-bottom: 40px;
      border-radius: 8px;
      border: 1px solid #e8e5df;
    }

    .fr-accordion-toc ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .fr-accordion-toc li {
      margin-bottom: 12px;
    }

    .fr-accordion-toc li:last-child {
      margin-bottom: 0;
    }

    .fr-accordion-toc a {
      color: #2a2a2a;
      text-decoration: none;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: color 0.2s ease;
    }

    .fr-accordion-toc a::before {
      content: '→';
      color: #999;
      transition: transform 0.2s ease, color 0.2s ease;
    }

    .fr-accordion-toc a:hover {
      color: #000;
    }

    .fr-accordion-toc a:hover::before {
      transform: translateX(3px);
      color: #000;
    }

    /* ===================================================
       ACCORDÉON H3 (Tiroirs principaux)
       =================================================== */

    .fr-accordion-item {
      border-bottom: 1px solid #e5e5e5;
    }

    .fr-accordion-item:first-child {
      border-top: 1px solid #e5e5e5;
    }

    .fr-accordion-h3 {
      cursor: pointer;
      padding: 18px 45px 18px 0;
      margin: 0;
      position: relative;
      font-size: 1.15em;
      font-weight: 600;
      color: #1a1a1a;
      line-height: 1.4;
      transition: color 0.2s ease;
      user-select: none;
      -webkit-user-select: none;
    }

    .fr-accordion-h3:hover {
      color: #555;
    }

    .fr-accordion-h3::after {
      content: '+';
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.5em;
      font-weight: 300;
      color: #999;
      transition: transform 0.3s ease;
    }

    .fr-accordion-h3.fr-open::after {
      content: '−';
    }

    .fr-accordion-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease;
    }

    .fr-accordion-body-inner {
      padding: 0 0 25px 0;
    }

    /* ===================================================
       SOUS-ACCORDÉON H4 (Tiroirs secondaires)
       =================================================== */

    .fr-sub-accordion-item {
      border-bottom: 1px solid #f0f0f0;
      margin-left: 10px;
    }

    .fr-sub-accordion-item:last-child {
      border-bottom: none;
    }

    .fr-sub-accordion-h4 {
      cursor: pointer;
      padding: 14px 40px 14px 0;
      margin: 0;
      position: relative;
      font-size: 0.95em;
      font-weight: 500;
      color: #333;
      line-height: 1.4;
      transition: color 0.2s ease;
      user-select: none;
      -webkit-user-select: none;
    }

    .fr-sub-accordion-h4:hover {
      color: #666;
    }

    .fr-sub-accordion-h4::after {
      content: '+';
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.2em;
      font-weight: 300;
      color: #bbb;
      transition: transform 0.3s ease;
    }

    .fr-sub-accordion-h4.fr-open::after {
      content: '−';
    }

    .fr-sub-accordion-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease;
    }

    .fr-sub-accordion-body-inner {
      padding: 0 0 20px 0;
    }

    /* ===================================================
       CONTENU TEXTE
       =================================================== */

    .fr-accordion-body-inner p,
    .fr-sub-accordion-body-inner p {
      font-size: 14px;
      line-height: 1.7;
      color: #444;
      margin-bottom: 12px;
    }

    .fr-accordion-body-inner p:last-child,
    .fr-sub-accordion-body-inner p:last-child {
      margin-bottom: 0;
    }

    .fr-accordion-body-inner a,
    .fr-sub-accordion-body-inner a {
      color: #1a1a1a;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .fr-accordion-body-inner a:hover,
    .fr-sub-accordion-body-inner a:hover {
      color: #666;
    }

    .fr-accordion-body-inner ul,
    .fr-sub-accordion-body-inner ul {
      padding-left: 20px;
      margin-bottom: 12px;
    }

    .fr-accordion-body-inner li,
    .fr-sub-accordion-body-inner li {
      font-size: 14px;
      line-height: 1.7;
      color: #444;
      margin-bottom: 6px;
    }

    .fr-accordion-body-inner strong,
    .fr-sub-accordion-body-inner strong {
      color: #1a1a1a;
    }

    /* ===================================================
       RESPONSIVE
       =================================================== */

    @media (max-width: 768px) {
      .fr-accordion-wrapper {
        padding: 0 15px;
      }

      .fr-accordion-h3 {
        font-size: 1em;
        padding: 15px 40px 15px 0;
      }

      .fr-sub-accordion-h4 {
        font-size: 0.9em;
        padding: 12px 35px 12px 0;
      }

      .fr-sub-accordion-item {
        margin-left: 5px;
      }

      .fr-accordion-toc {
        padding: 18px 20px;
      }

      .fr-section-wrapper {
        margin-top: {{ section.settings.margin_top | divided_by: 1.5 }}px;
        margin-bottom: {{ section.settings.margin_bottom | divided_by: 1.5 }}px;
      }
    }
  </style>

  <script>
    (function() {
      var sectionId = 'fr-accordion-{{ section.id }}';
      
      if (window['faroushInit_' + sectionId]) return;
      window['faroushInit_' + sectionId] = true;

      function initFaroushAccordion() {
        var wrapper = document.querySelector('#shopify-section-{{ section.id }} .fr-accordion-wrapper');
        if (!wrapper || wrapper.dataset.initialized) return;
        
        wrapper.dataset.initialized = 'true';

        var rawDiv = wrapper.querySelector('.fr-accordion-content-raw');
        var renderedDiv = wrapper.querySelector('.fr-accordion-rendered');
        if (!rawDiv || !renderedDiv) return;

        var rawHTML = rawDiv.innerHTML.trim();
        
        if (!rawHTML) {
          console.log('Faroush Accordion: Contenu vide');
          return;
        }

        var tempContainer = document.createElement('div');
        tempContainer.innerHTML = rawHTML;

        var children = Array.from(tempContainer.childNodes);
        var structure = [];
        var tocItems = [];
        var currentH3 = null;
        var currentH4 = null;
        var h3Index = 0;

        children.forEach(function(node) {
          // Détection des H3 (accordéons principaux)
          if (node.nodeType === 1 && node.tagName === 'H3') {
            h3Index++;
            var h3Id = 'fr-section-' + h3Index + '-' + Math.random().toString(36).substr(2, 5);
            currentH3 = {
              tag: 'h3',
              text: node.textContent,
              id: h3Id,
              children: [],
              content: []
            };
            currentH4 = null;
            structure.push(currentH3);
            tocItems.push({ text: node.textContent, id: h3Id });
          }
          // Détection des H4 (sous-accordéons)
          else if (node.nodeType === 1 && node.tagName === 'H4') {
            if (!currentH3) {
              h3Index++;
              var autoH3Id = 'fr-section-' + h3Index + '-' + Math.random().toString(36).substr(2, 5);
              currentH3 = {
                tag: 'h3',
                text: 'Contenu',
                id: autoH3Id,
                children: [],
                content: []
              };
              structure.push(currentH3);
            }
            currentH4 = {
              tag: 'h4',
              text: node.textContent,
              content: []
            };
            currentH3.children.push(currentH4);
          }
          else {
            var htmlContent = (node.nodeType === 1) ? node.outerHTML : (node.textContent.trim() ? node.textContent : '');
            if (htmlContent) {
              if (currentH4) {
                currentH4.content.push(htmlContent);
              } else if (currentH3) {
                currentH3.content.push(htmlContent);
              }
            }
          }
        });

        var outputHTML = '';

        // Génération du sommaire
        if (tocItems.length > 1) {
          outputHTML += '<nav class="fr-accordion-toc"><ul>';
          tocItems.forEach(function(item) {
            outputHTML += '<li><a href="#' + item.id + '">' + item.text + '</a></li>';
          });
          outputHTML += '</ul></nav>';
        }

        // Génération des accordéons
        structure.forEach(function(h3Item) {
          outputHTML += '<div class="fr-accordion-item" id="' + h3Item.id + '">';
          outputHTML += '<h3 class="fr-accordion-h3">' + h3Item.text + '</h3>';
          outputHTML += '<div class="fr-accordion-body"><div class="fr-accordion-body-inner">';

          if (h3Item.content.length > 0) {
            outputHTML += h3Item.content.join('');
          }

          h3Item.children.forEach(function(h4Item) {
            outputHTML += '<div class="fr-sub-accordion-item">';
            outputHTML += '<h4 class="fr-sub-accordion-h4">' + h4Item.text + '</h4>';
            outputHTML += '<div class="fr-sub-accordion-body"><div class="fr-sub-accordion-body-inner">';
            outputHTML += h4Item.content.join('');
            outputHTML += '</div></div></div>';
          });

          outputHTML += '</div></div></div>';
        });

        renderedDiv.innerHTML = outputHTML;

        // Event listeners pour H3
        renderedDiv.querySelectorAll('.fr-accordion-h3').forEach(function(h3El) {
          h3El.addEventListener('click', function() {
            var body = this.nextElementSibling;
            var isOpen = this.classList.contains('fr-open');

            if (isOpen) {
              body.style.maxHeight = '0';
              this.classList.remove('fr-open');
            } else {
              body.style.maxHeight = body.scrollHeight + 'px';
              this.classList.add('fr-open');
            }
          });
        });

        // Event listeners pour H4
        renderedDiv.querySelectorAll('.fr-sub-accordion-h4').forEach(function(h4El) {
          h4El.addEventListener('click', function() {
            var body = this.nextElementSibling;
            var isOpen = this.classList.contains('fr-open');
            var parentBody = this.closest('.fr-accordion-body');

            if (isOpen) {
              body.style.maxHeight = '0';
              this.classList.remove('fr-open');
            } else {
              body.style.maxHeight = body.scrollHeight + 'px';
              this.classList.add('fr-open');
            }

            setTimeout(function() {
              if (parentBody && parentBody.previousElementSibling.classList.contains('fr-open')) {
                parentBody.style.maxHeight = parentBody.scrollHeight + 'px';
              }
            }, 50);
          });
        });

        // Ouvre le premier accordéon par défaut
        var firstH3 = renderedDiv.querySelector('.fr-accordion-h3');
        if (firstH3) {
          firstH3.classList.add('fr-open');
          var firstBody = firstH3.nextElementSibling;
          if (firstBody) {
            firstBody.style.maxHeight = firstBody.scrollHeight + 'px';

            var firstH4 = firstBody.querySelector('.fr-sub-accordion-h4');
            if (firstH4) {
              firstH4.classList.add('fr-open');
              var firstH4Body = firstH4.nextElementSibling;
              if (firstH4Body) {
                firstH4Body.style.maxHeight = firstH4Body.scrollHeight + 'px';

                setTimeout(function() {
                  firstBody.style.maxHeight = firstBody.scrollHeight + 'px';
                }, 50);
              }
            }
          }
        }

        // Liens du sommaire
        renderedDiv.querySelectorAll('.fr-accordion-toc a').forEach(function(link) {
          link.addEventListener('click', function(e) {
            e.preventDefault();
            var targetId = this.getAttribute('href').substring(1);
            var targetItem = document.getElementById(targetId);
            if (!targetItem) return;

            var h3El = targetItem.querySelector('.fr-accordion-h3');
            if (h3El && !h3El.classList.contains('fr-open')) {
              h3El.click();
            }

            setTimeout(function() {
              targetItem.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          });
        });

        console.log('Faroush Accordion: Initialisé - ' + structure.length + ' sections H3 trouvées');
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFaroushAccordion);
      } else {
        initFaroushAccordion();
      }

      if (window.Shopify && window.Shopify.designMode) {
        document.addEventListener('shopify:section:load', initFaroushAccordion);
      }
    })();
  </script>

{% else %}
  
  <div style="padding: 40px 20px; text-align: center; background: #f9f9f9; border: 2px dashed #ddd; margin: 20px;">
    <p style="color: #666; font-size: 14px; margin-bottom: 15px;">
      ⚠️ Aucun contenu FAQ trouvé
    </p>
  </div>

{% endif %}

{% schema %}
{
  "name": "FAQ Accordéon Faroush",
  "tag": "section",
  "class": "faroush-accordion-section",
  "settings": [
    {
      "type": "header",
      "content": "📝 Contenu (optionnel pour test)"
    },
    {
      "type": "html",
      "id": "manual_content",
      "label": "Contenu manuel de test",
      "info": "Laissez vide pour utiliser automatiquement le metafield custom.faq. Structure: H3 pour questions principales, H4 pour sous-questions."
    },
    {
      "type": "paragraph",
      "content": "💡 Cette section utilise H3 pour les accordéons principaux et H4 pour les sous-accordéons (optimisé SEO)."
    },
    {
      "type": "header",
      "content": "🎨 Mise en page"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Largeur maximale",
      "default": 900
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Marge en haut",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Marge en bas",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Afficher une bordure en haut",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordéon Faroush"
    }
  ]
}
{% endschema %}
