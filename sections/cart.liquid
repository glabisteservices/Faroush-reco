<div class="padding-global padding-section-small">
  <div class="container-large">
    <div class="headline-wrapper">
      <h2 class="heading-style-h2">{{ section.settings.text_heading }}</h2>
      <a href="{{ routes.root_url }}" class="text-size-small text-style-link hide-mobile-landscape">
        <span>{{ section.settings.text_continue_shopping }}</span>
      </a>
    </div>

    {% if cart.item_count > 0 %}
    <div class="cart_form-block w-form">
      <div
        class="cart_grid-wrapper"
        x-data="{
          cartTotal: {{ cart.total_price }},
          loading: false,
          formatMoney(cents) {
            return (cents / 100).toFixed(2).replace('.', ',') + '\u00a0€';
          },
          updateQuantity(line, quantity) {
            this.loading = true;
            fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ line: line, quantity: quantity })
            })
            .then(res => res.json())
            .then(cart => {
              this.cartTotal = cart.total_price;
              this.loading = false;
              if (quantity === 0) window.location.reload();
            })
            .catch(() => { this.loading = false; });
          }
        }"
      >
        <div class="cart_table outline-solid-1">
          <div class="cart_grid is-header w-hidden-tiny">
            <div class="cart_table-header">
              <p class="text-size-regular">{{ section.settings.text_product }}</p>
            </div>
            <div class="cart_table-header">
              <p class="text-size-regular">{{ section.settings.text_quantity }}</p>
            </div>
            <div class="cart_table-header">
              <p class="text-size-regular">{{ section.settings.text_price }}</p>
            </div>
          </div>

          {% for item in cart.items %}
          <div class="cart_grid">
            <div class="display-inlineflex">
              <a href="{{ item.url }}" class="w-inline-block">
                <img src="{{ item.image | image_url: width: 200 }}" alt="" class="cart_image">
              </a>
              <div class="cart_info-order">
                <a href="{{ item.url }}" class="text-size-regular">{{ item.title }}</a>
              </div>
            </div>

            <div class="cart_table-item anzahl">
              <div class="cart_quantity-wrapper">
                <div>Quantity</div>
                <input
                  class="cart_quantity w-input"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  x-on:change="updateQuantity({{ forloop.index }}, parseInt($event.target.value))"
                  :disabled="loading"
                >
              </div>
              <a href="{{ item.url_to_remove }}" class="text-size-tiny text-style-link text-align-center w-inline-block">
                <div>{{ section.settings.text_remove }}</div>
              </a>
            </div>

            <div class="cart_price-info">
              <div class="text-size-regular">{{ item.final_line_price | money }}</div>
              {% if item.original_line_price > item.final_line_price %}
              <div class="text-size-regular text-style-strikethrough">{{ item.original_line_price | money }}</div>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>

        <div class="cart_wrapper-right">
          <div class="cart_table outline-solid-1">
            <div class="cart_grid is-header w-hidden-tiny">
              <div class="cart_table-header">
                <p class="text-size-regular">{{ section.settings.text_summary }}</p>
              </div>
            </div>
            <div class="cart_content">
              <div class="cart_wrapper">
                <div class="cart_details-wrapper">
                  <div class="text-size-regular">{{ section.settings.text_sum_inkl_vat }}</div>
                  <div class="cart_details-price">
                    {% if cart.total_discounts > 0 %}
                    <div class="text-style-strikethrough">{{ cart.original_total_price | money }}</div>
                    {% endif %}
                    <div class="heading-style-h3" x-text="formatMoney(cartTotal)">{{ cart.total_price | money }}</div>
                  </div>
                </div>
                {% if cart.total_discounts > 0 %}
                <div class="cart_details-wrapper">
                  <div class="text-size-regular">{{ section.settings.text_discount }}</div>
                  <div>{{ cart.total_discount | money }}</div>
                </div>
                {% endif %}
              </div>
              <div class="cart_action">
                <a href="/checkout" class="button w-button" :class="{ 'opacity-50': loading }">Checkout</a>
              </div>
            </div>
          </div>

          <div class="cart_table outline-solid-1">
            <div class="cart_grid is-header w-hidden-tiny">
              <div class="cart_table-header">
                <p class="text-size-regular">{{ section.settings.text_comment }}</p>
              </div>
            </div>
            <div class="cart_content">
              <div class="form_field-wrapper">
                <textarea class="form_input is-text-area w-input" maxlength="5000" name="note" placeholder="Comment" id="CartNote"></textarea>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
    {% endif %}

    {% if cart.item_count == 0 %}
    <div class="cart_empty outline-solid-1">
      <div>{{ section.settings.text_cart_empty }}</div>
      <a href="{{ routes.root_url }}" class="button w-button">Shop Now</a>
    </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "tag": "section",
  "name": "Cart",
  "class": "section_account",
  "settings": [
    { "id": "text_heading", "type": "text", "label": "Heading", "default": "Cart" },
    { "id": "text_continue_shopping", "type": "text", "label": "Continue shopping", "default": "Continue shopping" },
    { "id": "text_product", "type": "text", "label": "Product", "default": "Product" },
    { "id": "text_quantity", "type": "text", "label": "Quantity", "default": "Quantity" },
    { "id": "text_price", "type": "text", "label": "Price", "default": "Price" },
    { "id": "text_remove", "type": "text", "label": "Remove", "default": "Remove" },
    { "id": "text_summary", "type": "text", "label": "Summary", "default": "Summary" },
    { "id": "text_sum_inkl_vat", "type": "text", "label": "Sum (inkl. Vat.)", "default": "Sum (inkl. Vat.)" },
    { "id": "text_discount", "type": "text", "label": "Discount", "default": "Discount" },
    { "id": "text_comment", "type": "text", "label": "Comment", "default": "Comment" },
    { "id": "text_cart_empty", "type": "text", "label": "Cart Empty", "default": "No Products yet." }
  ],
  "presets": [
    { "name": "Cart", "category": "Liquify", "blocks": [] }
  ],
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}
