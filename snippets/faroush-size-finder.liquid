{% comment %}
  Faroush Size Finder — snippet Liquid
  Emplacement recommandé : sections/product-form.liquid
  Collez ce bloc juste AVANT la ligne contenant le bouton "Ajouter au panier"
  (cherchez "add-to-cart" ou "AddToCart" dans votre thème)
{% endcomment %}

<div id="faroush-size-finder" style="margin-bottom: 16px;">

  <button
    type="button"
    id="fsf-toggle"
    onclick="fsfToggle()"
    style="
      width: 100%;
      padding: 11px 16px;
      background: #FBF4EC;
      border: 1px solid #E8D5BB;
      border-radius: 8px;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      color: #7A5530;
    "
  >
    <span style="display:flex;align-items:center;gap:8px;">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0">
        <path d="M8 1a7 7 0 100 14A7 7 0 008 1zM7 5h2v2H7V5zm0 3h2v4H7V8z" fill="#C8975A"/>
      </svg>
      Trouver ma taille
    </span>
    <svg id="fsf-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" style="transition:transform 0.2s">
      <path d="M3 5l4 4 4-4" stroke="#C8975A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div id="fsf-panel" style="display:none; padding: 16px; border: 1px solid #E8D5BB; border-top: none; border-radius: 0 0 8px 8px; background: #fff;">

    <!-- Étape 1 : méthode -->
    <div id="fsf-s0" class="fsf-step">
      <p style="font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#999;margin:0 0 6px;font-weight:500;">Étape 1 / 2</p>
      <p style="font-size:15px;font-weight:500;color:#1a1a1a;margin:0 0 14px;line-height:1.3;">Comment voulez-vous trouver la taille ?</p>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
        <div class="fsf-chip" data-val="cm" onclick="fsfPickMethod(this)" style="padding:10px 14px;border:1px solid #ddd;border-radius:8px;cursor:pointer;font-size:14px;color:#1a1a1a;">
          Je mesure le pied de mon enfant en cm
        </div>
        <div class="fsf-chip" data-val="eu" onclick="fsfPickMethod(this)" style="padding:10px 14px;border:1px solid #ddd;border-radius:8px;cursor:pointer;font-size:14px;color:#1a1a1a;">
          Je connais déjà sa pointure EU
        </div>
      </div>
      <button type="button" id="fsf-btn0" onclick="fsfGoStep(1)" disabled style="padding:10px 20px;background:#1a1a1a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;opacity:.35;">
        Continuer →
      </button>
    </div>

    <!-- Étape 2a : mesure cm -->
    <div id="fsf-s1a" class="fsf-step" style="display:none;">
      <button type="button" onclick="fsfGoStep(0)" style="background:none;border:none;color:#999;font-size:13px;cursor:pointer;padding:0;margin-bottom:12px;">← Retour</button>
      <p style="font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#999;margin:0 0 6px;font-weight:500;">Étape 2 / 2</p>
      <p style="font-size:15px;font-weight:500;color:#1a1a1a;margin:0 0 4px;line-height:1.3;">Longueur du pied de votre enfant</p>
      <p style="font-size:12px;color:#999;margin:0 0 14px;line-height:1.5;">Tracez le contour du pied sur une feuille, mesurez du talon au bout du grand orteil.</p>
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
        <input type="range" min="110" max="225" value="155" step="1" id="fsf-slider"
          oninput="fsfUpdateCm(this.value)"
          style="flex:1;accent-color:#C8975A;"
        >
        <span id="fsf-cm-out" style="font-size:18px;font-weight:500;color:#1a1a1a;min-width:58px;">15,5 cm</span>
      </div>
      <button type="button" onclick="fsfShowResultCm()" style="padding:10px 20px;background:#1a1a1a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;">
        Voir ma taille →
      </button>
    </div>

    <!-- Étape 2b : pointure EU -->
    <div id="fsf-s1b" class="fsf-step" style="display:none;">
      <button type="button" onclick="fsfGoStep(0)" style="background:none;border:none;color:#999;font-size:13px;cursor:pointer;padding:0;margin-bottom:12px;">← Retour</button>
      <p style="font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#999;margin:0 0 6px;font-weight:500;">Étape 2 / 2</p>
      <p style="font-size:15px;font-weight:500;color:#1a1a1a;margin:0 0 14px;line-height:1.3;">Pointure actuelle de votre enfant</p>
      <div id="fsf-eu-chips" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;"></div>
      <button type="button" id="fsf-btn-eu" onclick="fsfShowResultEu()" disabled style="padding:10px 20px;background:#1a1a1a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;opacity:.35;">
        Voir ma taille →
      </button>
    </div>

    <!-- Résultat -->
    <div id="fsf-result" class="fsf-step" style="display:none;">
      <p style="font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#C8975A;margin:0 0 6px;font-weight:500;">Votre taille Faroush</p>
      <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:4px;">
        <span id="fsf-size-hero" style="font-size:48px;font-weight:500;color:#C8975A;line-height:1;">—</span>
        <span style="font-size:13px;color:#999;">EU</span>
      </div>
      <p id="fsf-range-label" style="font-size:12px;color:#999;margin:0 0 10px;"></p>
      <div id="fsf-bar-wrap" style="margin-bottom:6px;">
        <div style="background:#f3ede6;border-radius:4px;height:5px;overflow:hidden;">
          <div id="fsf-bar" style="height:100%;width:50%;background:#C8975A;border-radius:4px;transition:width .4s;"></div>
        </div>
      </div>
      <p id="fsf-margin-msg" style="font-size:12px;color:#888;margin:0 0 12px;line-height:1.5;"></p>
      <div style="background:#FBF4EC;border-radius:6px;padding:10px 12px;margin-bottom:14px;">
        <p style="font-size:12px;color:#7A5530;margin:0;line-height:1.6;"><strong>Conseil Faroush :</strong> nos chaussures sont true to size. La toe box large laisse les orteils respirer — inutile de prendre une taille au-dessus.</p>
      </div>
      <button type="button" id="fsf-select-btn" onclick="fsfSelectSize()" style="width:100%;padding:11px 16px;background:#1a1a1a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;margin-bottom:8px;">
        Sélectionner la taille <span id="fsf-select-label">—</span> sur cette fiche
      </button>
      <button type="button" onclick="fsfReset()" style="width:100%;padding:8px;background:none;border:none;color:#999;font-size:13px;cursor:pointer;">
        Recommencer
      </button>
    </div>

  </div>
</div>

<script>
(function() {
  var FSF = {
    method: null,
    euVal: null,
    cmVal: 15.5,
    result: null,

    sizeTable: [
      { eu: 19, cm: [11.0, 11.5] },
      { eu: 20, cm: [11.6, 12.1] },
      { eu: 21, cm: [12.2, 12.7] },
      { eu: 22, cm: [12.8, 13.3] },
      { eu: 23, cm: [13.4, 13.9] },
      { eu: 24, cm: [14.0, 14.5] },
      { eu: 25, cm: [14.6, 15.1] },
      { eu: 26, cm: [15.2, 15.7] },
      { eu: 27, cm: [15.8, 16.3] },
      { eu: 28, cm: [16.4, 16.9] },
      { eu: 29, cm: [17.0, 17.5] },
      { eu: 30, cm: [17.6, 18.1] },
      { eu: 31, cm: [18.2, 18.7] },
      { eu: 32, cm: [18.8, 19.3] },
      { eu: 33, cm: [19.4, 19.9] },
      { eu: 34, cm: [20.0, 20.5] },
      { eu: 35, cm: [20.6, 21.1] }
    ]
  };

  window.fsfToggle = function() {
    var panel = document.getElementById('fsf-panel');
    var chevron = document.getElementById('fsf-chevron');
    var open = panel.style.display === 'block';
    panel.style.display = open ? 'none' : 'block';
    chevron.style.transform = open ? '' : 'rotate(180deg)';
    if (!open) fsfBuildEuChips();
  };

  window.fsfPickMethod = function(el) {
    document.querySelectorAll('.fsf-chip').forEach(function(c) {
      c.style.border = '1px solid #ddd';
      c.style.background = '#fff';
      c.style.color = '#1a1a1a';
      c.style.fontWeight = 'normal';
    });
    el.style.border = '2px solid #C8975A';
    el.style.background = '#FBF4EC';
    el.style.color = '#7A5530';
    el.style.fontWeight = '500';
    FSF.method = el.dataset.val;
    var btn = document.getElementById('fsf-btn0');
    btn.disabled = false;
    btn.style.opacity = '1';
  };

  window.fsfGoStep = function(n) {
    ['fsf-s0','fsf-s1a','fsf-s1b','fsf-result'].forEach(function(id) {
      document.getElementById(id).style.display = 'none';
    });
    if (n === 0) {
      document.getElementById('fsf-s0').style.display = 'block';
    } else if (n === 1) {
      if (FSF.method === 'cm') {
        document.getElementById('fsf-s1a').style.display = 'block';
      } else {
        fsfBuildEuChips();
        document.getElementById('fsf-s1b').style.display = 'block';
      }
    }
  };

  function fsfBuildEuChips() {
    var el = document.getElementById('fsf-eu-chips');
    if (el.children.length) return;
    FSF.sizeTable.forEach(function(row) {
      var c = document.createElement('div');
      c.className = 'fsf-eu-chip';
      c.dataset.val = row.eu;
      c.textContent = row.eu;
      c.style.cssText = 'padding:8px 14px;border:1px solid #ddd;border-radius:6px;cursor:pointer;font-size:14px;color:#1a1a1a;background:#fff;';
      c.onclick = function() {
        document.querySelectorAll('.fsf-eu-chip').forEach(function(x) {
          x.style.border = '1px solid #ddd';
          x.style.background = '#fff';
          x.style.color = '#1a1a1a';
          x.style.fontWeight = 'normal';
        });
        c.style.border = '2px solid #C8975A';
        c.style.background = '#FBF4EC';
        c.style.color = '#7A5530';
        c.style.fontWeight = '500';
        FSF.euVal = parseInt(c.dataset.val);
        var btn = document.getElementById('fsf-btn-eu');
        btn.disabled = false;
        btn.style.opacity = '1';
      };
      el.appendChild(c);
    });
  }

  window.fsfUpdateCm = function(v) {
    FSF.cmVal = parseFloat(v) / 10;
    document.getElementById('fsf-cm-out').textContent = FSF.cmVal.toFixed(1).replace('.', ',') + ' cm';
  };

  function fsfFindByCm(cm) {
    for (var i = 0; i < FSF.sizeTable.length; i++) {
      var row = FSF.sizeTable[i];
      if (cm >= row.cm[0] && cm <= row.cm[1]) return row;
    }
    if (cm < FSF.sizeTable[0].cm[0]) return FSF.sizeTable[0];
    return FSF.sizeTable[FSF.sizeTable.length - 1];
  }

  window.fsfShowResultCm = function() {
    fsfRenderResult(fsfFindByCm(FSF.cmVal), FSF.cmVal);
  };

  window.fsfShowResultEu = function() {
    var row = FSF.sizeTable.find(function(r) { return r.eu === FSF.euVal; });
    fsfRenderResult(row, null);
  };

  function fsfRenderResult(row, cm) {
    FSF.result = row.eu;
    document.getElementById('fsf-size-hero').textContent = row.eu;
    document.getElementById('fsf-select-label').textContent = row.eu;
    document.getElementById('fsf-range-label').textContent =
      'Longueur pied : ' + row.cm[0].toFixed(1).replace('.', ',') + ' – ' + row.cm[1].toFixed(1).replace('.', ',') + ' cm';

    var cmUsed = cm !== null ? cm : (row.cm[0] + row.cm[1]) / 2;
    var pos = Math.round(((cmUsed - row.cm[0]) / (row.cm[1] - row.cm[0])) * 100);
    pos = Math.max(5, Math.min(95, pos));
    document.getElementById('fsf-bar').style.width = pos + '%';

    var msg = pos < 30
      ? 'Votre enfant est en début de pointure — beaucoup de marge devant lui.'
      : pos > 70
        ? 'Votre enfant est en fin de pointure — pensez à la taille suivante dans 2-3 mois.'
        : 'Au cœur de la pointure — parfait pour toute la saison.';
    document.getElementById('fsf-margin-msg').textContent = msg;

    ['fsf-s0','fsf-s1a','fsf-s1b'].forEach(function(id) {
      document.getElementById(id).style.display = 'none';
    });
    document.getElementById('fsf-result').style.display = 'block';
  }

  /**
   * Sélection automatique de la taille sur la fiche produit Shopify.
   * Compatible avec les thèmes Dawn, Debut, Brooklyn, Impulse, Pipeline.
   * La logique cherche un input radio ou un bouton variant dont le label
   * correspond à la taille EU trouvée (ex: "35", "EU 35", "35 EU").
   */
  window.fsfSelectSize = function() {
    if (!FSF.result) return;
    var target = String(FSF.result);
    var selected = false;

    /* 1. Inputs radio (thèmes classiques) */
    var radios = document.querySelectorAll('input[type="radio"]');
    for (var i = 0; i < radios.length; i++) {
      var r = radios[i];
      var label = (r.value || r.dataset.value || r.getAttribute('aria-label') || '').toString().trim();
      if (label === target || label === 'EU ' + target || label === target + ' EU') {
        r.click();
        selected = true;
        break;
      }
    }

    /* 2. Boutons variant (thèmes modernes : Dawn, etc.) */
    if (!selected) {
      var btns = document.querySelectorAll('[data-value], .variant-selector button, .product-form__input button, fieldset button');
      for (var j = 0; j < btns.length; j++) {
        var b = btns[j];
        var bval = (b.dataset.value || b.textContent || '').toString().trim();
        if (bval === target || bval === 'EU ' + target || bval === target + ' EU') {
          b.click();
          selected = true;
          break;
        }
      }
    }

    /* 3. Select natif (thèmes anciens) */
    if (!selected) {
      var selects = document.querySelectorAll('select[name*="size"], select[id*="size"], select[name*="taille"]');
      for (var k = 0; k < selects.length; k++) {
        var opts = selects[k].options;
        for (var m = 0; m < opts.length; m++) {
          var oval = (opts[m].value || opts[m].text || '').toString().trim();
          if (oval === target || oval === 'EU ' + target || oval === target + ' EU') {
            selects[k].value = opts[m].value;
            selects[k].dispatchEvent(new Event('change', { bubbles: true }));
            selected = true;
            break;
          }
        }
        if (selected) break;
      }
    }

    /* Feedback visuel */
    var btn = document.getElementById('fsf-select-btn');
    if (selected) {
      btn.textContent = 'Taille ' + target + ' sélectionnée ✓';
      btn.style.background = '#2D6A4F';
      setTimeout(function() { document.getElementById('faroush-size-finder').scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 100);
    } else {
      btn.textContent = 'Taille ' + target + ' — sélectionnez-la manuellement ci-dessus';
      btn.style.background = '#8B5E3C';
    }
  };

  window.fsfReset = function() {
    FSF.method = null; FSF.euVal = null; FSF.result = null; FSF.cmVal = 15.5;
    document.getElementById('fsf-slider').value = 155;
    document.getElementById('fsf-cm-out').textContent = '15,5 cm';
    document.getElementById('fsf-eu-chips').innerHTML = '';
    document.querySelectorAll('.fsf-chip').forEach(function(c) {
      c.style.border = '1px solid #ddd';
      c.style.background = '#fff';
      c.style.color = '#1a1a1a';
      c.style.fontWeight = 'normal';
    });
    var btn = document.getElementById('fsf-select-btn');
    btn.textContent = 'Sélectionner la taille — sur cette fiche';
    btn.style.background = '#1a1a1a';
    document.getElementById('fsf-btn0').disabled = true;
    document.getElementById('fsf-btn0').style.opacity = '.35';
    fsfGoStep(0);
  };
})();
</script>