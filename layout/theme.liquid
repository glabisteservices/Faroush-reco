    }

    .fr-sub-accordion-h3 {
      font-size: 0.9em;
      padding: 12px 35px 12px 0;
    }

    .fr-sub-accordion-item {
      margin-left: 5px;
    }

    .fr-accordion-toc {
      padding: 18px 20px;
    }

    .fr-description-section {
      margin-top: 40px;
      margin-bottom: 40px;
    }

    .fr-faq-section {
      margin-top: 30px;
      margin-bottom: 60px;
      padding-top: 30px;
    }
  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function() {

    document.querySelectorAll('.fr-accordion-wrapper').forEach(function(wrapper) {

      var rawDiv = wrapper.querySelector('.fr-accordion-content-raw');
      var renderedDiv = wrapper.querySelector('.fr-accordion-rendered');
      if (!rawDiv || !renderedDiv) return;

      var rawHTML = rawDiv.innerHTML;
      var tempContainer = document.createElement('div');
      tempContainer.innerHTML = rawHTML;

      var children = Array.from(tempContainer.childNodes);
      var structure = [];
      var tocItems = [];
      var currentH2 = null;
      var currentH3 = null;
      var h2Index = 0;

      /* ---- Parse le HTML brut en structure H2 > H3 > contenu ---- */

      children.forEach(function(node) {

        if (node.nodeType === 1 && node.tagName === 'H2') {
          h2Index++;
          var h2Id = 'fr-section-' + h2Index + '-' + Math.random().toString(36).substr(2, 5);
          currentH2 = {
            tag: 'h2',
            text: node.textContent,
            id: h2Id,
            children: [],
            content: []
          };
          currentH3 = null;
          structure.push(currentH2);
          tocItems.push({ text: node.textContent, id: h2Id });
        }

        else if (node.nodeType === 1 && node.tagName === 'H3') {
          if (!currentH2) {
            h2Index++;
            var autoH2Id = 'fr-section-' + h2Index + '-' + Math.random().toString(36).substr(2, 5);
            currentH2 = {
              tag: 'h2',
              text: 'Contenu',
              id: autoH2Id,
              children: [],
              content: []
            };
            structure.push(currentH2);
          }
          currentH3 = {
            tag: 'h3',
            text: node.textContent,
            content: []
          };
          currentH2.children.push(currentH3);
        }

        else {
          var htmlContent = (node.nodeType === 1) ? node.outerHTML : (node.textContent.trim() ? node.textContent : '');
          if (htmlContent) {
            if (currentH3) {
              currentH3.content.push(htmlContent);
            } else if (currentH2) {
              currentH2.content.push(htmlContent);
            }
          }
        }
      });

      /* ---- Génère le sommaire ---- */

      var outputHTML = '';

      if (tocItems.length > 1) {
        outputHTML += '<nav class="fr-accordion-toc"><ul>';
        tocItems.forEach(function(item) {
          outputHTML += '<li><a href="#' + item.id + '">' + item.text + '</a></li>';
        });
        outputHTML += '</ul></nav>';
      }

      /* ---- Génère les tiroirs H2 / H3 ---- */

      structure.forEach(function(h2Item, idx) {
        outputHTML += '<div class="fr-accordion-item" id="' + h2Item.id + '">';
        outputHTML += '<h2 class="fr-accordion-h2">' + h2Item.text + '</h2>';
        outputHTML += '<div class="fr-accordion-body"><div class="fr-accordion-body-inner">';

        /* Contenu direct sous le H2 (avant tout H3) */
        if (h2Item.content.length > 0) {
          outputHTML += h2Item.content.join('');
        }

        /* Sous-accordéons H3 */
        h2Item.children.forEach(function(h3Item, h3Idx) {
          outputHTML += '<div class="fr-sub-accordion-item">';
          outputHTML += '<h3 class="fr-sub-accordion-h3">' + h3Item.text + '</h3>';
          outputHTML += '<div class="fr-sub-accordion-body"><div class="fr-sub-accordion-body-inner">';
          outputHTML += h3Item.content.join('');
          outputHTML += '</div></div></div>';
        });

        outputHTML += '</div></div></div>';
      });

      renderedDiv.innerHTML = outputHTML;

      /* ---- Toggle H2 ---- */

      renderedDiv.querySelectorAll('.fr-accordion-h2').forEach(function(h2El) {
        h2El.addEventListener('click', function() {
          var body = this.nextElementSibling;
          var isOpen = this.classList.contains('fr-open');

          if (isOpen) {
            body.style.maxHeight = '0';
            this.classList.remove('fr-open');
          } else {
            body.style.maxHeight = body.scrollHeight + 'px';
            this.classList.add('fr-open');
          }
        });
      });

      /* ---- Toggle H3 ---- */

      renderedDiv.querySelectorAll('.fr-sub-accordion-h3').forEach(function(h3El) {
        h3El.addEventListener('click', function() {
          var body = this.nextElementSibling;
          var isOpen = this.classList.contains('fr-open');
          var parentBody = this.closest('.fr-accordion-body');

          if (isOpen) {
            body.style.maxHeight = '0';
            this.classList.remove('fr-open');
          } else {
            body.style.maxHeight = body.scrollHeight + 'px';
            this.classList.add('fr-open');
          }

          /* Recalcule la hauteur du parent H2 */
          setTimeout(function() {
            if (parentBody && parentBody.previousElementSibling.classList.contains('fr-open')) {
              parentBody.style.maxHeight = parentBody.scrollHeight + 'px';
            }
          }, 50);
        });
      });

      /* ---- Ouvre le 1er H2 + 1er H3 par défaut ---- */

      var firstH2 = renderedDiv.querySelector('.fr-accordion-h2');
      if (firstH2) {
        firstH2.classList.add('fr-open');
        var firstBody = firstH2.nextElementSibling;
        if (firstBody) {
          firstBody.style.maxHeight = firstBody.scrollHeight + 'px';

          var firstH3 = firstBody.querySelector('.fr-sub-accordion-h3');
          if (firstH3) {
            firstH3.classList.add('fr-open');
            var firstH3Body = firstH3.nextElementSibling;
            if (firstH3Body) {
              firstH3Body.style.maxHeight = firstH3Body.scrollHeight + 'px';

              setTimeout(function() {
                firstBody.style.maxHeight = firstBody.scrollHeight + 'px';
              }, 50);
            }
          }
        }
      }

      /* ---- Scroll smooth pour le sommaire ---- */

      renderedDiv.querySelectorAll('.fr-accordion-toc a').forEach(function(link) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          var targetId = this.getAttribute('href').substring(1);
          var targetItem = document.getElementById(targetId);
          if (!targetItem) return;

          var h2El = targetItem.querySelector('.fr-accordion-h2');
          if (h2El && !h2El.classList.contains('fr-open')) {
            h2El.click();
          }

          setTimeout(function() {
            targetItem.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 100);
        });
      });

    }); /* fin forEach wrapper */

  }); /* fin DOMContentLoaded */
</script>

{%- endif -%}


  </div>
