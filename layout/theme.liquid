<style>
  /* ===================================================
     FAROUSH ACCORDION — BASE
     =================================================== */

  .fr-accordion-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .fr-description-section {
    margin-top: 60px;
    margin-bottom: 60px;
  }

  .fr-faq-section {
    margin-top: 40px;
    margin-bottom: 100px;
    padding-top: 50px;
    border-top: 1px solid #eee;
  }

  /* ===================================================
     SOMMAIRE (Table of Contents)
     =================================================== */

  .fr-accordion-toc {
    background: #f8f8f6;
    padding: 24px 28px;
    margin-bottom: 40px;
    border-radius: 8px;
    border: 1px solid #e8e5df;
  }

  .fr-accordion-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fr-accordion-toc li {
    margin-bottom: 12px;
  }

  .fr-accordion-toc li:last-child {
    margin-bottom: 0;
  }

  .fr-accordion-toc a {
    color: #2a2a2a;
    text-decoration: none;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s ease;
  }

  .fr-accordion-toc a::before {
    content: '→';
    color: #999;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .fr-accordion-toc a:hover {
    color: #000;
  }

  .fr-accordion-toc a:hover::before {
    transform: translateX(3px);
    color: #000;
  }

  /* ===================================================
     ACCORDÉON H2 (Tiroirs principaux)
     =================================================== */

  .fr-accordion-item {
    border-bottom: 1px solid #e5e5e5;
  }

  .fr-accordion-item:first-child {
    border-top: 1px solid #e5e5e5;
  }

  .fr-accordion-h2 {
    cursor: pointer;
    padding: 18px 45px 18px 0;
    margin: 0;
    position: relative;
    font-size: 1.15em;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.4;
    transition: color 0.2s ease;
    user-select: none;
    -webkit-user-select: none;
  }

  .fr-accordion-h2:hover {
    color: #555;
  }

  .fr-accordion-h2::after {
    content: '+';
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5em;
    font-weight: 300;
    color: #999;
    transition: transform 0.3s ease;
  }

  .fr-accordion-h2.fr-open::after {
    content: '−';
  }

  .fr-accordion-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .fr-accordion-body-inner {
    padding: 0 0 25px 0;
  }

  /* ===================================================
     SOUS-ACCORDÉON H3 (Tiroirs secondaires)
     =================================================== */

  .fr-sub-accordion-item {
    border-bottom: 1px solid #f0f0f0;
    margin-left: 10px;
  }

  .fr-sub-accordion-item:last-child {
    border-bottom: none;
  }

  .fr-sub-accordion-h3 {
    cursor: pointer;
    padding: 14px 40px 14px 0;
    margin: 0;
    position: relative;
    font-size: 0.95em;
    font-weight: 500;
    color: #333;
    line-height: 1.4;
    transition: color 0.2s ease;
    user-select: none;
    -webkit-user-select: none;
  }

  .fr-sub-accordion-h3:hover {
    color: #666;
  }

  .fr-sub-accordion-h3::after {
    content: '+';
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.2em;
    font-weight: 300;
    color: #bbb;
    transition: transform 0.3s ease;
  }

  .fr-sub-accordion-h3.fr-open::after {
    content: '−';
  }

  .fr-sub-accordion-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  .fr-sub-accordion-body-inner {
    padding: 0 0 20px 0;
  }

  /* ===================================================
     CONTENU TEXTE
     =================================================== */

  .fr-accordion-body-inner p,
  .fr-sub-accordion-body-inner p {
    font-size: 14px;
    line-height: 1.7;
    color: #444;
    margin-bottom: 12px;
  }

  .fr-accordion-body-inner p:last-child,
  .fr-sub-accordion-body-inner p:last-child {
    margin-bottom: 0;
  }

  .fr-accordion-body-inner a,
  .fr-sub-accordion-body-inner a {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .fr-accordion-body-inner a:hover,
  .fr-sub-accordion-body-inner a:hover {
    color: #666;
  }

  .fr-accordion-body-inner ul,
  .fr-sub-accordion-body-inner ul {
    padding-left: 20px;
    margin-bottom: 12px;
  }

  .fr-accordion-body-inner li,
  .fr-sub-accordion-body-inner li {
    font-size: 14px;
    line-height: 1.7;
    color: #444;
    margin-bottom: 6px;
  }

  .fr-accordion-body-inner strong,
  .fr-sub-accordion-body-inner strong {
    color: #1a1a1a;
  }

  /* ===================================================
     RESPONSIVE
     =================================================== */

  @media (max-width: 768px) {
    .fr-accordion-wrapper {
      padding: 0 15px;
    }

    .fr-accordion-h2 {
      font-size: 1em;
